# Ollama connection
# Default assumes a GPU host (see docker-compose.yml ollama service GPU reservation).
# On a CPU-only host, use a smaller model instead, e.g. llama3.2:3b.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model (runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths (relative to project root, override if needed)
POLICY_DOCS_DIR=app/data/policies
INDEX_DIR=app/data/index
TICKETS_DB_PATH=app/data/tickets.db

# RAG subgraph tuning
RAG_TOP_K=4
RAG_MAX_REWRITES=2
